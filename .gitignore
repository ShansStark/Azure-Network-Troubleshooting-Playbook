.env
*.pfx
*.pem
*.key
*.publishsettings
*.tfvars
local.settings.json

# Packet captures and logs
*.cap
*.pcap
*.pcapng
*.log

# Azure / PowerShell / Terraform local state (if you add labs later)
.terraform/
*.tfstate
*.tfstate.*
.azure/

# Scratch work
tmp/
scratch/
